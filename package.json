{
  "name": "meu-manager",
  "version": "0.1.0",
  "description": "Jogo de técnico de futebol",
  "scripts": {
    "test": "vitest run --project unit",
    "test:balance": "vitest run --project balance",
    "test:all": "vitest run",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:watch": "vitest --project unit",
    "analyze": "node tools/run.mjs analyze",
    "typecheck": "tsc -b --noEmit"
  },
  "type": "module",
  "private": "true",
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
